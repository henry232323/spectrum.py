{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForumChannelGroup",
  "description": "spectrum.models.Forum",
  "type": "object",
  "required": [
    "id",
    "community_id",
    "order",
    "name",
    "channels"
  ],
  "properties": {
    "id": {
      "$ref": "id.json"
    },
    "community_id": {
      "$ref": "id.json"
    },
    "order": {
      "type": "integer"
    },
    "name": {
      "type": "string"
    },
    "channels": {
      "type": "array",
      "items": {
        "$ref": "forum-channel.json"
      }
    }
  },
  "additionalProperties": true
}
