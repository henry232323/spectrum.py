{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadList",
  "description": "data of forum/channel/threads",
  "type": "object",
  "required": [
    "threads",
    "threads_count"
  ],
  "properties": {
    "threads": {
      "type": "array",
      "items": {
        "$ref": "thread-stub.json"
      }
    },
    "threads_count": {
      "type": "integer"
    },
    "latest": {
      "type": [
        "integer",
        "null"
      ]
    },
    "latest_timestamp": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
