{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ThreadStub",
  "description": "Thread summary from forum/channel/threads. spectrum.models.ThreadStub(**payload) is a dataclass: these required keys must be present and unknown keys raise TypeError.",
  "type": "object",
  "required": [
    "id",
    "time_created",
    "time_modified",
    "channel_id",
    "type",
    "slug",
    "subject",
    "is_locked",
    "is_pinned",
    "is_sinked",
    "is_erased",
    "erased_by",
    "tracked_post_role_id",
    "content_reply_id",
    "label",
    "subscription_key",
    "member",
    "votes",
    "replies_count",
    "views_count",
    "highlight_role_id",
    "latest_activity",
    "aspect"
  ],
  "properties": {
    "id": {
      "$ref": "id.json"
    },
    "time_created": {
      "type": "integer",
      "description": "Unix seconds"
    },
    "time_modified": {
      "type": "integer",
      "description": "Unix seconds"
    },
    "channel_id": {
      "$ref": "id.json"
    },
    "type": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "is_locked": {
      "type": "boolean"
    },
    "is_pinned": {
      "type": "boolean"
    },
    "is_sinked": {
      "type": "boolean"
    },
    "is_erased": {
      "type": "boolean"
    },
    "erased_by": {
      "anyOf": [
        {
          "$ref": "id.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "tracked_post_role_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "content_reply_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "label": {
      "type": [
        "object",
        "null"
      ]
    },
    "subscription_key": {
      "type": "string"
    },
    "member": {
      "$ref": "member.json"
    },
    "votes": {
      "$ref": "votes.json"
    },
    "replies_count": {
      "type": "integer"
    },
    "views_count": {
      "type": "integer"
    },
    "highlight_role_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "latest_activity": {
      "$ref": "activity.json"
    },
    "aspect": {
      "type": "string"
    },
    "is_new": {
      "type": "boolean"
    },
    "media_preview": {
      "type": [
        "object",
        "null"
      ]
    },
    "first_tracked_reply": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_reply_nesting_disabled": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "annotation_plaintext": {
      "type": [
        "string",
        "null"
      ]
    },
    "new_replies_count": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "additionalProperties": true,
  "x-python-strict": true
}
